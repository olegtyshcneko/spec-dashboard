---
import "../styles/global.css";
import { dashboardConfig, withBase } from "../lib/project";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — ${dashboardConfig.project.name}` : dashboardConfig.project.name;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23090d12'/%3E%3Cpath d='M4.5 4.5l4 3.5-4 3.5' fill='none' stroke='%23fbbf24' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M9.5 12h3' stroke='%23fb7185' stroke-width='1.8' stroke-linecap='round'/%3E%3C/svg%3E" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <div>
          <h1><a href={withBase()}>{dashboardConfig.project.name}</a></h1>
          <div class="subtitle">{dashboardConfig.project.tagline}</div>
        </div>
        <nav>
          <a href={withBase()}>Dashboard</a>
          <a href={withBase("roadmap/")}>Roadmap</a>
          <a href={withBase("knowledge/")}>Knowledge</a>
          <a href={withBase("graph/")}>Graph</a>
          <a href={withBase("health/")}>Health</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
