---
import "../styles/global.css";
import { dashboardConfig } from "../lib/project";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — ${dashboardConfig.project.name}` : dashboardConfig.project.name;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <div>
          <h1><a href="/">{dashboardConfig.project.name}</a></h1>
          <div class="subtitle">{dashboardConfig.project.tagline}</div>
        </div>
        <nav>
          <a href="/">Dashboard</a>
          <a href="/knowledge/">Knowledge</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
