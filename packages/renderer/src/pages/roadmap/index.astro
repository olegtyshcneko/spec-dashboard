---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { snapshot } from "../../lib/project";

const priorityRank = { p0: 0, p1: 1, p2: 2, p3: 3 };
const stateRank = { blocked: 0, review: 1, active: 2, ready: 3, backlog: 4, idea: 5, shipped: 6, archived: 7 };
const sortSpecs = (specs) => [...specs].sort((a, b) =>
  priorityRank[a.priority] - priorityRank[b.priority]
  || stateRank[a.state] - stateRank[b.state]
  || a.id.localeCompare(b.id));

const milestoneGroups = snapshot.milestones.map((milestone) => {
  const specs = sortSpecs(snapshot.specs.filter((spec) => spec.milestone === milestone.id && spec.state !== "archived"));
  const shipped = specs.filter((spec) => spec.state === "shipped").length;
  return {
    ...milestone,
    specs,
    shipped,
    progress: specs.length ? Math.round((shipped / specs.length) * 100) : 0,
    dateStart: milestone.startDate ?? milestone.completedDate ?? milestone.targetDate,
    dateEnd: milestone.completedDate ?? milestone.targetDate ?? milestone.startDate,
  };
});
const unscheduledSpecs = sortSpecs(snapshot.specs.filter((spec) => !spec.milestone && !["shipped", "archived"].includes(spec.state)));
const unscheduledGroup = unscheduledSpecs.length > 0 ? {
  id: "unscheduled",
  label: "Unscheduled work",
  description: "Open work that has not yet been selected for a delivery milestone.",
  status: "active",
  specs: unscheduledSpecs,
  shipped: 0,
  progress: 0,
} : null;
const groups = unscheduledGroup ? [...milestoneGroups, unscheduledGroup] : milestoneGroups;
const latestCompleted = milestoneGroups
  .filter((milestone) => milestone.status === "completed" && milestone.completedDate)
  .sort((a, b) => a.completedDate.localeCompare(b.completedDate))
  .at(-1) ?? null;
const scheduledCount = snapshot.specs.filter((spec) => spec.milestone && spec.state !== "archived").length;
const completedMilestones = milestoneGroups.filter((milestone) => milestone.status === "completed").length;
const lifecycleStates = [...new Set(snapshot.specs.filter((spec) => spec.state !== "archived").map((spec) => spec.state))].sort();

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const fmtDate = (iso) => {
  if (!iso) return "";
  const [year, month, day] = iso.split("-").map(Number);
  return `${MONTHS[month - 1]} ${day}, ${year}`;
};
const dateLabel = (milestone) => {
  if (milestone.completedDate) return `Completed ${fmtDate(milestone.completedDate)}`;
  if (milestone.startDate && milestone.targetDate) return `${fmtDate(milestone.startDate)} → ${fmtDate(milestone.targetDate)}`;
  if (milestone.targetDate) return `Target ${fmtDate(milestone.targetDate)}`;
  if (milestone.startDate) return `Started ${fmtDate(milestone.startDate)}`;
  return "No date yet";
};
const searchText = (milestone) => [milestone.id, milestone.label, milestone.description || ""].join(" ").toLowerCase();
const specSearchText = (spec) => [spec.id, spec.title, spec.summary, spec.state, spec.kind, spec.priority, ...(spec.categories || []), ...(spec.tags || [])].join(" ").toLowerCase();
---
<BaseLayout title="Roadmap">
  <main>
    <div class="roadmap-heading">
      <div>
        <p class="roadmap-eyebrow">Delivery view</p>
        <h1>Roadmap</h1>
        <p class="summary">Follow current delivery or reveal completed releases as a graphical vertical timeline or compact list.</p>
      </div>
    </div>

    <div class="roadmap-toolbar" aria-label="Roadmap controls">
      <div class="roadmap-control">
        <span class="roadmap-control-label" id="roadmap-scope-label">Scope</span>
        <div class="roadmap-scope-switch" role="group" aria-labelledby="roadmap-scope-label">
          <button type="button" data-scope-button="current" aria-pressed="false">Current</button>
          <button type="button" data-scope-button="all" aria-pressed="false">All</button>
          <button type="button" data-scope-button="completed" aria-pressed="false">Completed</button>
        </div>
      </div>

      <label>Milestone
        <select id="roadmap-milestone">
          <option value="">All milestones</option>
          {snapshot.milestones.map((milestone) => <option value={milestone.id}>{milestone.label}</option>)}
          {unscheduledGroup && <option value="unscheduled">Unscheduled work</option>}
        </select>
      </label>

      <label>Work state
        <select id="roadmap-state">
          <option value="">All states</option>
          {lifecycleStates.map((state) => <option value={state}>{state}</option>)}
        </select>
      </label>

      <label>Time range
        <select id="roadmap-range">
          <option value="">All time</option>
          <option value="30d">Last 30 days</option>
          <option value="90d">Last 90 days</option>
          <option value="1y">Last year</option>
          <option value="next90d">Next 90 days</option>
          <option value="year">This year</option>
        </select>
      </label>

      <label class="roadmap-search-control">Search
        <input id="roadmap-search" type="search" placeholder="Milestone or work item…" />
      </label>

      <button type="button" class="roadmap-clear" id="roadmap-clear">Clear filters</button>
    </div>

    <div class="roadmap-overview-row">
      <div class="roadmap-scope-status" id="roadmap-scope-status" aria-live="polite"></div>
      <div class="roadmap-view-switch" role="group" aria-label="Roadmap view">
        <button type="button" data-view-button="timeline" aria-pressed="false">Timeline</button>
        <button type="button" data-view-button="list" aria-pressed="false">List</button>
      </div>
      <div class="roadmap-summary" aria-label="Roadmap summary">
        <span><strong>{snapshot.milestones.length}</strong> milestones</span>
        <span><strong>{completedMilestones}</strong> delivered</span>
        <span><strong>{scheduledCount}</strong> specs scheduled</span>
      </div>
    </div>

    {snapshot.milestones.length === 0 && (
      <div class="roadmap-empty">
        <strong>No milestones configured.</strong>
        <p>Add an ordered <code>milestones</code> list to <code>specdash.config.yaml</code>, then assign work with the optional <code>milestone</code> field.</p>
      </div>
    )}

    <div class="roadmap-filter-empty" id="roadmap-filter-empty" role="status" hidden>No milestones or work items match these filters.</div>

    <section class="roadmap-panel" data-roadmap-panel="timeline" aria-label="Graphical roadmap timeline">
      <div class="roadmap-legend" aria-label="Timeline legend">
        <span><i data-milestone-status="active"></i>Active</span>
        <span><i data-milestone-status="planned"></i>Planned</span>
        <span><i data-milestone-status="completed"></i>Completed</span>
        <span><i class="roadmap-branch-key"></i>Assigned work</span>
      </div>
      <div class="roadmap-timeline">
        {groups.map((milestone) => (
          <article
            class="roadmap-timeline-node"
            data-roadmap-group
            data-milestone={milestone.id}
            data-milestone-status={milestone.status}
            data-date-start={milestone.dateStart}
            data-date-end={milestone.dateEnd}
            data-search={searchText(milestone)}
            data-spec-count={milestone.specs.length}
            data-latest-completed={latestCompleted && milestone.id === latestCompleted.id ? "true" : undefined}
          >
            <div class="roadmap-timeline-date">
              <span>{milestone.completedDate ? fmtDate(milestone.completedDate) : milestone.targetDate ? fmtDate(milestone.targetDate) : milestone.startDate ? fmtDate(milestone.startDate) : "No date"}</span>
            </div>
            <div class="roadmap-timeline-axis" aria-hidden="true"><span></span></div>
            <details class="roadmap-timeline-card" open={milestone.status !== "completed"}>
              <summary>
                <span class="roadmap-milestone-header">
                  <span>
                    <span class="roadmap-milestone-title">
                      <strong class="roadmap-milestone-name">{milestone.label}</strong>
                      {latestCompleted && milestone.id === latestCompleted.id && <span class="roadmap-latest-tag">Latest shipped</span>}
                    </span>
                    {milestone.description && <span class="roadmap-milestone-desc">{milestone.description}</span>}
                  </span>
                  <span class="roadmap-target">
                    {milestone.status === "completed"
                      ? milestone.completedDate && <span>Shipped <time datetime={milestone.completedDate}>{fmtDate(milestone.completedDate)}</time></span>
                      : (
                        <>
                          {milestone.startDate && <span>Started <time datetime={milestone.startDate}>{fmtDate(milestone.startDate)}</time></span>}
                          {milestone.targetDate && <span>Target <time datetime={milestone.targetDate}>{fmtDate(milestone.targetDate)}</time></span>}
                        </>
                      )}
                  </span>
                </span>
                <span class="roadmap-progress-row">
                  <span class="roadmap-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={milestone.progress} aria-label={`${milestone.label} completion`}>
                    <span style={`width: ${milestone.progress}%`}></span>
                  </span>
                  <span>{milestone.shipped}/{milestone.specs.length} shipped</span>
                </span>
              </summary>
              {milestone.specs.length === 0 ? <p class="empty">No work assigned yet. Add <code>milestone: {milestone.id}</code> to a spec's frontmatter to schedule it here.</p> : (
                <div class="roadmap-timeline-work">
                  {milestone.specs.map((spec) => (
                    <a
                      class="roadmap-timeline-item"
                      href={spec.href}
                      data-roadmap-spec
                      data-spec-state={spec.state}
                      data-search={specSearchText(spec)}
                    >
                      <span class="roadmap-node-id">{spec.id}</span>
                      <strong>{spec.title}</strong>
                      <span>{spec.summary}</span>
                      <small><span class="pill" data-status={spec.state}>{spec.state}</span>{spec.priority} · {spec.kind}</small>
                    </a>
                  ))}
                </div>
              )}
            </details>
          </article>
        ))}
      </div>
    </section>

    <section class="roadmap-panel" data-roadmap-panel="list" aria-label="Roadmap list" hidden>
      <div class="roadmap-list">
        {groups.map((milestone) => (
          <details
            class:list={["roadmap-milestone", milestone.id === "unscheduled" && "roadmap-unscheduled"]}
            open={milestone.status !== "completed"}
            data-roadmap-group
            data-milestone={milestone.id}
            data-milestone-status={milestone.status}
            data-date-start={milestone.dateStart}
            data-date-end={milestone.dateEnd}
            data-search={searchText(milestone)}
            data-spec-count={milestone.specs.length}
            data-latest-completed={latestCompleted && milestone.id === latestCompleted.id ? "true" : undefined}
          >
            <summary>
              <span class="roadmap-milestone-header">
                <span>
                  <span class="roadmap-milestone-title">
                    <strong class="roadmap-milestone-name">{milestone.label}</strong>
                    <span class="milestone-status" data-status={milestone.status}>{milestone.status}</span>
                    {latestCompleted && milestone.id === latestCompleted.id && <span class="roadmap-latest-tag">Latest shipped</span>}
                  </span>
                  {milestone.description && <span class="roadmap-milestone-desc">{milestone.description}</span>}
                </span>
                <span class="roadmap-target"><span>{dateLabel(milestone)}</span></span>
              </span>
              <span class="roadmap-progress-row">
                <span class="roadmap-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={milestone.progress} aria-label={`${milestone.label} completion`}>
                  <span style={`width: ${milestone.progress}%`}></span>
                </span>
                <span>{milestone.shipped}/{milestone.specs.length} shipped</span>
              </span>
            </summary>
            {milestone.specs.length === 0 ? <p class="empty">No work assigned yet. Add <code>milestone: {milestone.id}</code> to a spec's frontmatter to schedule it here.</p> : (
              <div class="roadmap-items">
                {milestone.specs.map((spec) => (
                  <a
                    class="roadmap-item"
                    href={spec.href}
                    data-roadmap-spec
                    data-spec-state={spec.state}
                    data-search={specSearchText(spec)}
                  >
                    <span class="pill" data-status={spec.state}>{spec.state}</span>
                    <span class="roadmap-item-body">
                      <strong>{spec.id} · {spec.title}</strong>
                      <span>{spec.summary}</span>
                      {spec.nextAction && <small>Next: {spec.nextAction}</small>}
                    </span>
                    <span class="roadmap-item-meta">{spec.priority} · {spec.kind}</span>
                  </a>
                ))}
              </div>
            )}
          </details>
        ))}
      </div>
    </section>
  </main>
  <script>
    const validScopes = new Set(["current", "all", "completed"]);
    const validViews = new Set(["timeline", "list"]);
    const validRanges = new Set(["30d", "90d", "1y", "next90d", "year"]);
    const params = new URLSearchParams(location.search);
    let activeScope = validScopes.has(params.get("scope")) ? params.get("scope") : "current";
    let activeView = validViews.has(params.get("view")) ? params.get("view") : "timeline";
    const milestoneSelect = document.querySelector("#roadmap-milestone");
    const stateSelect = document.querySelector("#roadmap-state");
    const search = document.querySelector("#roadmap-search");
    const rangeSelect = document.querySelector("#roadmap-range");
    const status = document.querySelector("#roadmap-scope-status");
    const empty = document.querySelector("#roadmap-filter-empty");
    const clearButton = document.querySelector("#roadmap-clear");
    milestoneSelect.value = params.get("milestone") || "";
    stateSelect.value = params.get("state") || "";
    search.value = params.get("q") || "";
    rangeSelect.value = validRanges.has(params.get("range")) ? params.get("range") : "";

    let activeRange = null;

    function isoDate(date) {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
    }

    function shiftDays(days) {
      const date = new Date();
      date.setDate(date.getDate() + days);
      return isoDate(date);
    }

    function rangeWindow() {
      const today = isoDate(new Date());
      switch (rangeSelect.value) {
        case "30d": return [shiftDays(-30), today];
        case "90d": return [shiftDays(-90), today];
        case "1y": return [shiftDays(-365), today];
        case "next90d": return [today, shiftDays(90)];
        case "year": return [`${today.slice(0, 4)}-01-01`, `${today.slice(0, 4)}-12-31`];
        default: return null;
      }
    }

    function updateUrl() {
      const next = new URLSearchParams();
      next.set("scope", activeScope);
      next.set("view", activeView);
      if (milestoneSelect.value) next.set("milestone", milestoneSelect.value);
      if (stateSelect.value) next.set("state", stateSelect.value);
      if (rangeSelect.value) next.set("range", rangeSelect.value);
      if (search.value.trim()) next.set("q", search.value.trim());
      history.replaceState(null, "", `${location.pathname}?${next}`);
    }

    function groupMatchesScope(group) {
      if (activeScope === "all") return true;
      if (activeScope === "completed") return group.dataset.milestoneStatus === "completed";
      return group.dataset.milestoneStatus !== "completed" || group.dataset.latestCompleted === "true";
    }

    function filterGroup(group) {
      const query = search.value.trim().toLowerCase();
      const milestoneMatches = !milestoneSelect.value || group.dataset.milestone === milestoneSelect.value;
      const scopeMatches = groupMatchesScope(group);
      const rangeMatches = !activeRange || Boolean(
        group.dataset.dateStart
        && group.dataset.dateStart <= activeRange[1]
        && group.dataset.dateEnd >= activeRange[0]
      );
      const groupSearchMatches = !query || group.dataset.search.includes(query);
      let visibleSpecs = 0;
      const specs = [...group.querySelectorAll("[data-roadmap-spec]")];
      for (const spec of specs) {
        const stateMatches = !stateSelect.value || spec.dataset.specState === stateSelect.value;
        const searchMatches = groupSearchMatches || !query || spec.dataset.search.includes(query);
        spec.hidden = !(stateMatches && searchMatches);
        if (!spec.hidden) visibleSpecs += 1;
      }
      const workFilterActive = Boolean(stateSelect.value || query);
      const workMatches = !workFilterActive || visibleSpecs > 0 || (Number(group.dataset.specCount) === 0 && groupSearchMatches);
      group.hidden = !(milestoneMatches && scopeMatches && rangeMatches && workMatches);
      if (workFilterActive && !group.hidden) {
        const details = group.matches("details") ? group : group.querySelector("details");
        if (details) details.open = true;
      }
      return !group.hidden;
    }

    function render() {
      activeRange = rangeWindow();
      document.querySelectorAll("[data-scope-button]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.scopeButton === activeScope));
      });
      document.querySelectorAll("[data-view-button]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.viewButton === activeView));
      });
      document.querySelectorAll("[data-roadmap-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.roadmapPanel !== activeView;
      });

      const activePanel = document.querySelector(`[data-roadmap-panel="${activeView}"]`);
      const visibleGroups = [...activePanel.querySelectorAll("[data-roadmap-group]")].filter(filterGroup).length;
      document.querySelectorAll("[data-roadmap-panel]").forEach((panel) => {
        if (panel !== activePanel) panel.querySelectorAll("[data-roadmap-group]").forEach(filterGroup);
      });
      const scopeLabel = activeScope === "current" ? "current delivery" : activeScope === "completed" ? "completed history" : "full roadmap";
      const totalGroups = activePanel.querySelectorAll("[data-roadmap-group]").length;
      status.textContent = `Showing ${visibleGroups} of ${totalGroups} milestones · ${scopeLabel}`;
      empty.hidden = visibleGroups > 0;
      clearButton.disabled = activeScope === "current" && !milestoneSelect.value && !stateSelect.value && !rangeSelect.value && !search.value.trim();
      updateUrl();
    }

    document.querySelectorAll("[data-scope-button]").forEach((button) => button.addEventListener("click", () => {
      activeScope = button.dataset.scopeButton;
      render();
    }));
    document.querySelectorAll("[data-view-button]").forEach((button) => button.addEventListener("click", () => {
      activeView = button.dataset.viewButton;
      render();
    }));
    milestoneSelect.addEventListener("change", render);
    stateSelect.addEventListener("change", render);
    rangeSelect.addEventListener("change", render);
    search.addEventListener("input", render);
    clearButton.addEventListener("click", () => {
      activeScope = "current";
      milestoneSelect.value = "";
      stateSelect.value = "";
      rangeSelect.value = "";
      search.value = "";
      document.querySelectorAll("[data-roadmap-group]").forEach((group) => {
        const details = group.matches("details") ? group : group.querySelector("details");
        if (details) details.open = group.dataset.milestoneStatus !== "completed";
      });
      render();
    });
    render();

    const hero = document.querySelector('[data-roadmap-panel]:not([hidden]) [data-roadmap-group]:not([hidden]):is([data-milestone-status="active"], [data-milestone-status="planned"])');
    if (hero && hero.getBoundingClientRect().bottom > window.innerHeight) {
      hero.scrollIntoView({ block: "center" });
    }
  </script>
</BaseLayout>
