---
import { getCollection, render } from "astro:content";
import ActivityHistory from "../../components/ActivityHistory.astro";
import EntryMeta from "../../components/EntryMeta.astro";
import Relationships from "../../components/Relationships.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/project";

export async function getStaticPaths() {
  return (await getCollection("specs")).map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title}>
  <article class="detail">
    <div class="crumb"><a href={withBase()}>← Dashboard</a></div>
    <header>
      <div style="display:flex;gap:10px;align-items:center;">
        <span class="pill" data-status={entry.data.state}>{entry.data.state}</span>
        <span class="prio" data-prio={entry.data.priority} title={`Priority ${entry.data.priority}`}></span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>
      <EntryMeta data={entry.data} />
      {entry.data.nextAction && <div class="action-callout"><strong>Next action</strong><p>{entry.data.nextAction}</p></div>}
      {(entry.data.blockers?.length ?? 0) > 0 && <div class="blocker-callout"><strong>Blockers</strong><ul>{entry.data.blockers?.map((blocker) => <li>{blocker}</li>)}</ul></div>}
    </header>
    <div class="entry-body"><Content /></div>
    <Relationships id={entry.data.id} />
    <ActivityHistory id={entry.data.id} />
  </article>
</BaseLayout>
