{
  "name": "@spec-dashboard/cli",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "bin": {
    "specdash": "./dist/bin.mjs"
  },
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --sourcemap --outfile=dist/bin.mjs --external:astro --external:fast-glob --external:gray-matter --external:yaml --external:zod"
  },
  "dependencies": {
    "@spec-dashboard/core": "0.9.0",
    "@spec-dashboard/renderer": "0.9.0",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
